{
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "pnpm --filter \"./packages/*\" build",
    "format": "prettier --write .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "git config --local include.path ../.github/.gitconfig && git config core.hooksPath .github/.githooks",
    "lint": "ls-lint && eslint .",
    "test:all": "pnpm --filter \"./packages/*\" test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "chai": "^6.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "json": "^11.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-package-json": "^2.8.0",
    "prettier-plugin-sh": "^0.20.2",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.9.0"
